{
  "version": "1.0",
  "cues": [
    { "id": "run1_start_1", "path": "/audio/tts/run1/start_1.mp3", "duration": 4.2, "text": "The maze breathes on a schedule. Every twenty seconds, it shifts. Learn the rhythm." },
    { "id": "run1_start_2", "path": "/audio/tts/run1/start_2.mp3", "duration": 3.8, "text": "You have two minutes before the first gate moves. Count." },
    { "id": "run1_start_3", "path": "/audio/tts/run1/start_3.mp3", "duration": 3.5, "text": "Trust what you hear. For now." },
    { "id": "run2_start_1", "path": "/audio/tts/run2/start_1.mp3", "duration": 4.0, "text": "The Architect speaks. But the signal is compromised." },
    { "id": "run2_start_2", "path": "/audio/tts/run2/start_2.mp3", "duration": 3.6, "text": "Some of what you hear is true. Some is not. You will learn to tell the difference." },
    { "id": "run2_start_3", "path": "/audio/tts/run2/start_3.mp3", "duration": 4.1, "text": "The hum leads somewhere. Whether it leads to the exit—that is the question." },
    { "id": "run3_start_1", "path": "/audio/tts/run3/start_1.mp3", "duration": 4.5, "text": "Two clocks now. Major shift every thirty seconds. Minor shift every ten." },
    { "id": "run3_start_2", "path": "/audio/tts/run3/start_2.mp3", "duration": 3.9, "text": "There are exits that are not exits. The real one plays a different tone." },
    { "id": "run3_start_3", "path": "/audio/tts/run3/start_3.mp3", "duration": 4.2, "text": "Both clocks lie if you let them. Move before they sync." },
    { "id": "run4_start_1", "path": "/audio/tts/run4/start_1.mp3", "duration": 4.2, "text": "You earned this gate. One second per breath—bigger stone, same cruelty." },
    { "id": "run4_start_2", "path": "/audio/tts/run4/start_2.mp3", "duration": 3.9, "text": "Half the whispers still lie. The hum still moves. No minor reprieve." },
    { "id": "run4_start_3", "path": "/audio/tts/run4/start_3.mp3", "duration": 4.0, "text": "Life or death is marketing. The corridor is real. Move." },
    { "id": "wrong_turn_1", "path": "/audio/tts/common/wrong_turn_1.mp3", "duration": 2.1, "text": "Dead end." },
    { "id": "wrong_turn_2", "path": "/audio/tts/common/wrong_turn_2.mp3", "duration": 2.4, "text": "Not this way." },
    { "id": "wrong_turn_3", "path": "/audio/tts/common/wrong_turn_3.mp3", "duration": 2.8, "text": "The grid does not bend for you here." },
    { "id": "wrong_turn_4", "path": "/audio/tts/common/wrong_turn_4.mp3", "duration": 2.3, "text": "Wall." },
    { "id": "wrong_turn_5", "path": "/audio/tts/common/wrong_turn_5.mp3", "duration": 2.6, "text": "Incorrect. Recalibrate." },
    { "id": "wrong_turn_6", "path": "/audio/tts/common/wrong_turn_6.mp3", "duration": 3.0, "text": "The path ends. The clock does not." },
    { "id": "shift_warning_1", "path": "/audio/tts/common/shift_warning_1.mp3", "duration": 2.5, "text": "Shift in five." },
    { "id": "shift_warning_2", "path": "/audio/tts/common/shift_warning_2.mp3", "duration": 2.8, "text": "The grid is about to breathe. Move." },
    { "id": "shift_warning_3", "path": "/audio/tts/common/shift_warning_3.mp3", "duration": 3.1, "text": "Five seconds to configuration change. Find open space." },
    { "id": "exit_found", "path": "/audio/tts/common/exit_found.mp3", "duration": 3.5, "text": "Exit confirmed. You remembered the rhythm." },
    { "id": "decoy_exit_1", "path": "/audio/tts/common/decoy_exit_1.mp3", "duration": 2.9, "text": "Not the exit. Keep moving." },
    { "id": "decoy_exit_2", "path": "/audio/tts/common/decoy_exit_2.mp3", "duration": 3.2, "text": "This is a test. The real exit sounds different." },
    { "id": "lie_1", "path": "/audio/tts/common/lie_1.mp3", "duration": 2.7, "text": "The exit is north." },
    { "id": "lie_2", "path": "/audio/tts/common/lie_2.mp3", "duration": 2.5, "text": "Follow the hum east." },
    { "id": "lie_3", "path": "/audio/tts/common/lie_3.mp3", "duration": 2.8, "text": "I see the gate. Go west." },
    { "id": "lie_4", "path": "/audio/tts/common/lie_4.mp3", "duration": 2.6, "text": "South corridor is clear." },
    { "id": "lie_5", "path": "/audio/tts/common/lie_5.mp3", "duration": 3.0, "text": "The signal is strongest to your right." },
    { "id": "lie_6", "path": "/audio/tts/common/lie_6.mp3", "duration": 2.9, "text": "Turn back. The exit is behind you." },
    { "id": "truth_1", "path": "/audio/tts/common/truth_1.mp3", "duration": 2.7, "text": "The exit is north." },
    { "id": "truth_2", "path": "/audio/tts/common/truth_2.mp3", "duration": 2.5, "text": "Follow the hum east." },
    { "id": "truth_3", "path": "/audio/tts/common/truth_3.mp3", "duration": 2.8, "text": "I see the gate. Go west." },
    { "id": "truth_4", "path": "/audio/tts/common/truth_4.mp3", "duration": 2.6, "text": "South corridor is clear." },
    { "id": "truth_5", "path": "/audio/tts/common/truth_5.mp3", "duration": 3.0, "text": "The signal is strongest to your right." },
    { "id": "truth_6", "path": "/audio/tts/common/truth_6.mp3", "duration": 2.9, "text": "Turn back. The exit is behind you." }
  ]
}
